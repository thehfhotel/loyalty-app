# Development Environment Configuration
# Copy this file to .env and fill in your development values

# ===========================================
# ENVIRONMENT
# ===========================================
NODE_ENV=development

# ===========================================
# LOCAL DEVELOPMENT URLs (New ports to avoid prod conflicts)
# ===========================================
# Development uses port 5001 (Production uses 4001)
FRONTEND_URL=http://localhost:5001
BACKEND_URL=http://localhost:5001/api
VITE_API_URL=http://localhost:5001/api
VITE_TRANSLATION_ENABLED=false

# ===========================================
# FEATURE TOGGLES
# ===========================================
TRANSLATION_FEATURE_ENABLED=false

# Port configuration (internal container ports)
BACKEND_PORT=4000
FRONTEND_PORT=3000

# ===========================================
# DATABASE CONFIGURATION (LOCAL DEVELOPMENT)
# ===========================================
# For Docker containers, use container names
# Note: External access uses port 5435 (dev) vs 5434 (prod)
DATABASE_URL=postgresql://loyalty_dev:loyalty_dev_pass@postgres:5432/loyalty_dev_db
REDIS_URL=redis://redis:6379

# ===========================================
# SECURITY SECRETS (DEVELOPMENT ONLY!)
# ===========================================
# ⚠️ CRITICAL: Production requires 64+ character secrets for security
# Generate strong random values with: openssl rand -base64 64
#
# EXAMPLE 64-char secrets (DO NOT use these exact values - generate your own):
JWT_SECRET=EXAMPLE_DO_NOT_USE_bXlzdXBlcnNlY3JldGp3dHNlY3JldGtleWZvcmRldmVsb3BtZW50YW5kcHJvZHVjdGlvbjEyMzQ1Njc4OTA=
JWT_REFRESH_SECRET=EXAMPLE_DO_NOT_USE_bXlyZWZyZXNoc2VjcmV0a2V5Zm9yand0dG9rZW5zZGV2ZWxvcG1lbnRhbmRwcm9kdWN0aW9uOTg3NjU0MzIxMA==
SESSION_SECRET=EXAMPLE_DO_NOT_USE_bXlzZXNzaW9uc2VjcmV0a2V5Zm9yY29va2llc2lnbmluZ2RldmVsb3BtZW50YW5kcHJvZHVjdGlvbjExMjIzMzQ0NTU=

# ===========================================
# OAUTH CONFIGURATION (DEVELOPMENT)
# ===========================================
# For development, create test apps in respective OAuth provider consoles
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/oauth/google/callback

LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CALLBACK_URL=http://localhost:5001/api/oauth/line/callback

# ===========================================
# LINE OA INTEGRATION (docs/launch-plan.md)
# ===========================================
# Messaging API channels — one per property OA. All channels MUST live
# under the same LINE provider as the Login channel (ADR-0002).
LINE_MESSAGING_HF_ACCESS_TOKEN=
LINE_MESSAGING_HF_CHANNEL_SECRET=
LINE_MESSAGING_HFVILLE_ACCESS_TOKEN=
LINE_MESSAGING_HFVILLE_CHANNEL_SECRET=

# Free-plan push budget per OA per calendar month (C5, plan §8). Each OA
# gets ~300 free pushes a month, shared by everything we send, so the
# allowance is split into fixed buckets. Blank = the plan default below,
# NOT zero — a blank is read as unset. The auto-verify bucket is fixed at 0
# in code and has no variable.
LINE_PUSH_BUDGET_OPS=
LINE_PUSH_BUDGET_CAMPAIGN=
LINE_PUSH_BUDGET_RESERVE=
LINE_PUSH_BUDGET_TOTAL=

# ===========================================
# PMS BOOKING CHANNEL + STAY ACCRUAL (ADR-0003)
# ===========================================
# Outbound: loyalty -> PMS channel API (availability / create-booking).
PMS_BASE_URL=
PMS_CHANNEL_TOKEN=
# One-in-flight Redis hold guard (default: true). Every create already
# carries an `Idempotency-Key`, which the PMS collapses per caller token +
# property (new-hotel #305), so the guard is belt-and-braces. Set to `false`
# to retire it once the keyed path has been trusted in production; it does
# NOT turn idempotency off.
PMS_HOLD_GUARD=
# Inbound: PMS checkout hook -> POST /api/loyalty/stays (shared secret).
LOYALTY_SERVICE_TOKEN=

# Per-property PromptPay receiving accounts (13-digit IDs). Falls back to
# PROMPTPAY_TAX_ID when a per-property ID is unset.
PROMPTPAY_HF_ID=
PROMPTPAY_HFVILLE_ID=

# ===========================================
# OUTBOUND EMAIL (SMTP) — optional in development
# ===========================================
# Leave every value blank to run without email: the backend logs
# "SMTP Email: Not configured", skips sends, and /api/health reports
# "email": "not_configured". Blank counts as unset — compose passes these as
# ${SMTP_HOST:-}, so an absent value arrives as an empty string.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# From address on every outgoing message (issue #352).
#
# - Unset or blank => falls back to SMTP_USER, which is the historical
#   behaviour, so leaving this empty changes nothing.
# - Accepts a bare address (noreply@example.com) or the display-name form
#   ("Loyalty App <noreply@example.com>"). A malformed value is logged as an
#   ERROR at startup, because it fails every send.
# - MUST be an address the authenticated mailbox genuinely OWNS. Providers
#   accept the AUTH and then reject the message with
#   `553 5.7.1 <addr>: Sender address rejected: not owned by user ...` if it
#   is only an alias — the same error a lapsed subscription produces, which
#   is what made this hard to diagnose.
SMTP_FROM=

# Property mailboxes for the new-booking / deposit-received notification
# (B0). One short email per event, to the property's own desk. Blank = off.
BOOKING_NOTIFY_EMAIL_HF=
BOOKING_NOTIFY_EMAIL_HFVILLE=

# SlipOK degradation tracking (A4). The tracker turns a stream of SlipOK
# outcomes into ONE "slips are queued for manual verification" email to the
# property mailboxes above, and ONE recovery notice when it works again.
#
# SLIPOK_MONTHLY_QUOTA is the plan's monthly check allowance. Blank = UNKNOWN,
# and unknown is SILENT: no 80%-of-quota warning is ever sent. There is
# deliberately no default — the real number is the owner's to record (A3), and
# a guessed ceiling either cries wolf or stays quiet past the real limit.
#
# The other two are alert tuning and fall back to the backend defaults when
# blank: 3 consecutive no-verdict responses before degrading (a quota refusal
# degrades on the first one, since it will not fix itself), and 60 minutes
# before a second degradation alert may be sent, so a flapping vendor cannot
# turn one bad hour into forty emails.
SLIPOK_MONTHLY_QUOTA=
SLIPOK_DEGRADE_FAILURE_THRESHOLD=
SLIPOK_DEGRADE_ALERT_COOLDOWN_MINS=

# ===========================================
# ADMIN USER (DEVELOPMENT)
# ===========================================
LOYALTY_USERNAME=admin@localhost
LOYALTY_PASSWORD=your_admin_password

# Admin bootstrap allowlist (issue #348). Comma-separated, case-insensitive
# emails promoted to the 'admin' role automatically: at registration (the
# first JWT already carries role=admin) and by a startup sweep covering
# pre-existing 'customer' accounts with a matching email (incl.
# Google-OAuth-created; LINE-only accounts have email = NULL and can never
# match). Existing admin/super_admin rows are never touched; nothing is
# ever demoted. Empty/unset = off.
# Intended for E2E stacks and one-time first-admin bootstrap. REMOVE after
# use in production: registration does NOT verify email ownership, so
# anyone who registers a listed email becomes admin.
ADMIN_BOOTSTRAP_EMAILS=

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
# Logging level (debug for development)
LOG_LEVEL=debug

# CORS - allow all origins in development (port 5001 for dev, 4001 for prod)
CORS_ORIGINS=http://localhost:3000,http://localhost:5001,http://127.0.0.1:3000,http://127.0.0.1:5001

# File upload settings
MAX_FILE_SIZE=5242880
UPLOAD_DIR=/app/storage/uploads

# ===========================================
# OPTIONAL: TRANSLATION PROVIDER (ONLY IF ENABLED)
# ===========================================
# Leave blank unless you plan to integrate a translation provider
AZURE_TRANSLATION_TEXT_URI=
AZURE_TRANSLATION_KEY_1=
AZURE_TRANSLATION_KEY_2=
AZURE_TRANSLATION_REGION=

# ===========================================
# TRUSTED PROXIES (per-IP rate limiting)
# ===========================================
# Which hop's forwarding headers the public rate limiters believe. Behind
# the tunnel and nginx the TCP peer is the same container for every request
# on earth, so a per-IP budget keyed on the peer would be one global bucket
# that paying guests exhaust between them; `CF-Connecting-IP` (and failing
# that, the first `X-Forwarded-For` address) is the only thing that carries
# the real client address, and both are attacker-supplied unless the hop
# that set them is one we put there.
#
# Comma-separated IPs and CIDR blocks. Leave unset for the default
# (loopback plus the RFC1918 ranges a compose network is built from). A
# blank value reads as unset; set the literal `none` to trust no hop and
# key every limiter on the TCP peer, which is what a deployment that
# fronts the backend directly must do.
# TRUSTED_PROXIES=none
