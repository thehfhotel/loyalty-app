{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT l.booking_id      AS \"booking_id!\",\n               l.note,\n               b.property,\n               b.check_in_date   AS \"check_in_date!\",\n               b.total_price     AS \"total_price!\",\n               b.amount_due_now\n        FROM booking_deposit_links l\n        JOIN bookings b ON b.id = l.booking_id\n        WHERE l.id = $1\n        FOR UPDATE OF l\n        ",
