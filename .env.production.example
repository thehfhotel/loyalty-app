# Production Environment Configuration
# This file shows what environment variables are needed for production
# DO NOT use this file directly - configure these in GitHub Actions secrets instead

# ===========================================
# DOMAIN AND URL CONFIGURATION
# ===========================================
DOMAIN=your-domain.com
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://your-domain.com/api
VITE_API_URL=https://your-domain.com/api
VITE_TRANSLATION_ENABLED=false

# ===========================================
# FEATURE TOGGLES
# ===========================================
TRANSLATION_FEATURE_ENABLED=false

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# These remain as container names for internal Docker communication
POSTGRES_USER=CHANGE_ME_USER
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
POSTGRES_DB=CHANGE_ME_DB
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@postgres:5432/CHANGE_ME_DB
REDIS_URL=redis://redis:6379

# ===========================================
# SECURITY SECRETS (PRODUCTION)
# ===========================================
# Generate strong random values for production using: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_JWT_SECRET_64_CHAR_MIN_GENERATE_WITH_OPENSSL_RAND_BASE64_64
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_64_CHAR_MIN_GENERATE_WITH_OPENSSL
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_64_CHAR_MIN_GENERATE_WITH_OPENSSL_RAND

# ===========================================
# OAUTH CONFIGURATION (PRODUCTION)
# ===========================================
# Update these in your OAuth provider consoles with production domain
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://your-domain.com/api/oauth/google/callback

LINE_CHANNEL_ID=CHANGE_ME_LINE_CHANNEL_ID
LINE_CHANNEL_SECRET=CHANGE_ME_LINE_CHANNEL_SECRET
LINE_CALLBACK_URL=https://your-domain.com/api/oauth/line/callback

# ===========================================
# OUTBOUND EMAIL (SMTP)
# ===========================================
# Configure these as GitHub Actions *production environment* secrets — the
# deploy workflow reads them and writes the server-side .env. Password
# resets, address verification and booking mail all go through this relay;
# with it unset the backend logs the skip and /api/health reports
# "email": "not_configured" (informational only — it never fails the deploy).
SMTP_HOST=CHANGE_ME_smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_mailbox@your-domain.com
SMTP_PASS=CHANGE_ME_MAILBOX_PASSWORD

# From address on every outgoing message (issue #352).
#
# - Unset or blank => falls back to SMTP_USER (historical behaviour).
# - Accepts a bare address or the display-name form
#   ("Loyalty App <noreply@your-domain.com>"). A malformed value is logged as
#   an ERROR at startup, because it fails every send.
# - MUST be an address the authenticated mailbox genuinely OWNS. An alias is
#   refused *after* a successful AUTH with
#   `553 5.7.1 <addr>: Sender address rejected: not owned by user ...`.
#   A lapsed mailbox subscription produces the SAME 553, so treat that error
#   as "check billing" before "check the alias".
#
# NOTE: /api/health can only ever prove this is CONFIGURED, never that a
# message is DELIVERABLE. Verify a real send with
# `POST /api/admin/email/test` after changing any value here.
SMTP_FROM=CHANGE_ME_Loyalty App <noreply@your-domain.com>

# Property mailboxes for the new-booking / deposit-received notification
# (B0). Set in CI from the repository variables of the same name (not
# secrets: a mailbox address is not one). Blank = off for that property.
BOOKING_NOTIFY_EMAIL_HF=
BOOKING_NOTIFY_EMAIL_HFVILLE=

# SlipOK degradation tracking (A4). The tracker turns a stream of SlipOK
# outcomes into ONE "slips are queued for manual verification" email to the
# property mailboxes above, and ONE recovery notice when it works again.
#
# SLIPOK_MONTHLY_QUOTA is the plan's monthly check allowance (1..=10000000;
# anything outside that, including a typo, reads as unknown). Blank = UNKNOWN,
# and unknown is SILENT: no 80%-of-quota warning is ever sent. There is
# deliberately no default — the real number is the owner's to record (A3), and
# a guessed ceiling either cries wolf or stays quiet past the real limit.
#
# The other two are alert tuning and fall back to the backend defaults when
# blank: 3 consecutive no-verdict responses before degrading (a quota refusal
# degrades on the first one, since it will not fix itself), and 60 minutes
# before a second degradation alert may be sent, so a flapping vendor cannot
# turn one bad hour into forty emails.
SLIPOK_MONTHLY_QUOTA=
SLIPOK_DEGRADE_FAILURE_THRESHOLD=
SLIPOK_DEGRADE_ALERT_COOLDOWN_MINS=

# ===========================================
# ADMIN USER CONFIGURATION
# ===========================================
LOYALTY_USERNAME=CHANGE_ME_admin@your-domain.com
LOYALTY_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Admin bootstrap allowlist (issue #348). Comma-separated, case-insensitive
# emails promoted to the 'admin' role automatically: at registration (the
# first JWT already carries role=admin) and by a startup sweep covering
# pre-existing 'customer' accounts with a matching email. Google-OAuth
# accounts are covered; LINE-only accounts are created with email = NULL,
# so the allowlist can NEVER match them. Existing admin/super_admin rows
# are never touched; nothing is ever demoted. Empty/unset = off.
#
# ONE-TIME FIRST-ADMIN BOOTSTRAP — the procedure the code supports
# (full write-up: backend-rust/README.md, "First-admin bootstrap"):
#   1. Add ADMIN_BOOTSTRAP_EMAILS=you@example.com to the server-side .env
#      in the deploy directory on the host (the file docker compose reads).
#   2. Recreate the backend so it picks the value up:
#        docker compose -f docker-compose.yml -f docker-compose.ghcr.yml \
#          -f docker-compose.prod.yml up -d backend
#      (staging: use docker-compose.staging.yml; a plain `docker compose
#      restart` does NOT re-read .env).
#   3. Register — or log in via Google OAuth — with the listed address and
#      verify an admin-only endpoint answers 200 for that account.
#   4. REMOVE the variable from .env and recreate the backend again.
#
# Operational caveats:
# - The deploy workflows REGENERATE the server-side .env from GitHub
#   secrets on every deploy, and ADMIN_BOOTSTRAP_EMAILS is not part of
#   that payload — a hand-added value will not survive the next deploy.
#   Complete the bootstrap in one sitting, and still remove the value
#   yourself (step 4) rather than counting on a deploy to wipe it.
# - Registration does NOT verify email ownership: while this is set,
#   ANYONE who registers a listed address becomes admin. Keep the window
#   short. The backend logs a warning at startup while it is set in
#   production.
ADMIN_BOOTSTRAP_EMAILS=

# ===========================================
# PRODUCTION SETTINGS
# ===========================================
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGINS=https://your-domain.com

# ===========================================
# OPTIONAL: TRANSLATION PROVIDER SETTINGS
# (Only needed when TRANSLATION_FEATURE_ENABLED=true)
# ===========================================
AZURE_TRANSLATION_TEXT_URI=
AZURE_TRANSLATION_KEY_1=
AZURE_TRANSLATION_KEY_2=
AZURE_TRANSLATION_REGION=

# ===========================================
# IMPORTANT NOTES FOR PRODUCTION
# ===========================================
# 1. Never commit this file with real values to the repository
# 2. Configure all these values in GitHub Actions production environment secrets
# 3. Update OAuth provider callback URLs to use your production domain
# 4. Use strong, randomly generated passwords and secrets
# 5. Consider using different database credentials for production

# ===========================================
# TRUSTED PROXIES (per-IP rate limiting)
# ===========================================
# Which hop's forwarding headers the public rate limiters believe. Behind
# the tunnel and nginx the TCP peer is the same container for every request
# on earth, so a per-IP budget keyed on the peer would be one global bucket
# that paying guests exhaust between them; `CF-Connecting-IP` (and failing
# that, the first `X-Forwarded-For` address) is the only thing that carries
# the real client address, and both are attacker-supplied unless the hop
# that set them is one we put there.
#
# Comma-separated IPs and CIDR blocks. Leave unset for the default
# (loopback plus the RFC1918 ranges a compose network is built from). A
# blank value reads as unset; set the literal `none` to trust no hop and
# key every limiter on the TCP peer, which is what a deployment that
# fronts the backend directly must do.
# TRUSTED_PROXIES=none

# ===========================================
# PMS BOOKING CHANNEL + STAY ACCRUAL (ADR-0003, B4b)
# ===========================================
# In production these are NOT edited here — the deploy workflow writes the
# server-side .env from GitHub Actions. Set them once, on the repository:
#
#   gh variable set PMS_BASE_URL --body '<pms origin>'    (a VARIABLE: readable
#                                                          in the UI, and the
#                                                          rollback is blanking it)
#   gh secret   set PMS_CHANNEL_TOKEN                      (loyalty -> PMS)
#   gh secret   set LOYALTY_SERVICE_TOKEN                  (PMS -> loyalty)
#
# ...then run the deploy. Full recipe, the value to use for PMS_BASE_URL,
# and how to verify it live: docs/ops/pms-channel-wiring.md
#
# Unset = the channel is DARK. Availability lookups and holds fall back to
# the front desk, and PMS checkout stays are refused. That is the default
# and it is safe; a HALF-configured channel is the state to avoid, and the
# backend logs a warning at boot when it sees one.
#
# PMS_BASE_URL is an ORIGIN, no path: the client joins `api/channel/...`
# onto it. It is parsed at boot and the process REFUSES TO START on a value
# it cannot trust (plain http only to a loopback / host.docker.internal /
# dotless container host, no credentials, no query, no fragment).
PMS_BASE_URL=
PMS_CHANNEL_TOKEN=
LOYALTY_SERVICE_TOKEN=
