VITE_API_URL=http://localhost:4000/api
# LINE LIFF app id (from the LINE Login channel) — enables silent in-LINE login
VITE_LIFF_ID=
# Front-desk phone numbers shown on the public deposit page (/d/:token).
# Blank = the page prints "contact the front desk" with no number (B16 supplies these).
# Baked into the bundle at build time: setting them on the running container
# changes nothing, the frontend image has to be rebuilt and redeployed.
VITE_DESK_PHONE_HF=
VITE_DESK_PHONE_HFVILLE=
